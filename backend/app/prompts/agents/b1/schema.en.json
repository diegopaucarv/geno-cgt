          },
          "evidence_of_variation": {
            "type": "string",
            "description": "Concrete evidence citing interviewees."
          },
          "contrast_criteria": {
            "type": "string",
            "description": "Opposite profile."
          },
          "extreme_criteria": {
            "type": "string",
