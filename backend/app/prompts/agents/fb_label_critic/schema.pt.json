{
  "type": "object",
  "additionalProperties": false,
  "required": ["issues"],
  "properties": {
    "issues": {
      "type": "array",
      "description": "Problemas encontrados com o rótulo. Array vazio se o rótulo for bom.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "description", "suggestion"],
        "properties": {
          "label": {
            "type": "string",
            "description": "Nome do rótulo avaliado"
          },
          "description": {
            "type": "string",
            "description": "O que está errado com o rótulo"
          },
          "suggestion": {
            "type": "string",
            "description": "Como corrigir o problema"
          }
        }
      }
    }
  }
}
