{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "all_valid",
    "issues"
  ],
  "properties": {
    "all_valid": {
      "type": "boolean",
      "description": "true wenn ALLE Labels die Prüfung bestehen (alle SAT)"
    },
    "issues": {
      "type": "array",
      "description": "Gefundene Probleme. Leeres Array wenn all_valid true ist.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "verdict",
          "description"
        ],
        "properties": {
          "label": {
            "type": "string",
            "description": "Name des bewerteten Labels"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "SAT",
              "MOD",
              "FORCED"
            ],
            "description": "Urteil für dieses Label"
          },
          "type": {
            "type": "string",
            "enum": [
              "not_grounded",
              "wrong_gerund",
              "scope_issue",
              "overlap",
              "forced_pattern"
            ],
            "description": "Art des Problems (weglassen wenn SAT)"
          },
          "description": {
            "type": "string",
            "description": "Beschreibung des Problems. Wenn MOD, einen konkreten Vorschlag einfügen."
          }
        }
      }
    }
  }
}
