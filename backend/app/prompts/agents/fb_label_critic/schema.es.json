{
  "type": "object",
  "additionalProperties": false,
  "required": ["issues"],
  "properties": {
    "issues": {
      "type": "array",
      "description": "Problemas encontrados con la etiqueta. Array vacío si la etiqueta es buena.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "description", "suggestion"],
        "properties": {
          "label": {
            "type": "string",
            "description": "Nombre de la etiqueta evaluada"
          },
          "description": {
            "type": "string",
            "description": "Qué está mal con la etiqueta"
          },
          "suggestion": {
            "type": "string",
            "description": "Cómo corregir el problema"
          }
        }
      }
    }
  }
}
