{
  "type": "object",
  "additionalProperties": false,
  "required": ["issues"],
  "properties": {
    "issues": {
      "type": "array",
      "description": "Problems found with the label. Empty array if the label is good.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "description", "suggestion"],
        "properties": {
          "label": {
            "type": "string",
            "description": "Name of the evaluated label"
          },
          "description": {
            "type": "string",
            "description": "What is wrong with the label"
          },
          "suggestion": {
            "type": "string",
            "description": "How to fix the issue"
          }
        }
      }
    }
  }
}
