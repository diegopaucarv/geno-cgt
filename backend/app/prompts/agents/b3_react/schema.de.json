{
  "type": "object",
  "required": [
    "hypotheses"
  ],
  "properties": {
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "text",
          "level",
          "related_codes",
          "evidence_segments"
        ],
        "properties": {
          "text": {
            "type": "string",
            "description": "Hypothese in 1-2 Sätzen."
          },
          "level": {
            "type": "string",
            "enum": [
              "general",
              "specific",
              "emergent"
            ],
            "description": "Abstraktionsebene."
          },
          "related_codes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Namen der Codes, auf die es sich bezieht."
          },
          "evidence_segments": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "IDs der Segmente, die die Hypothese stützen."
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Konfidenz basierend auf Quantität und Qualität der Evidenz."
          }
        }
      }
    }
  }
}
