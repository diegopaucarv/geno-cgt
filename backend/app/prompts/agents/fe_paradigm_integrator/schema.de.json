              "label",
              "description"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "incident_refs": {
                "type": "array",
                "items": {
                  "type": "integer"
                }
              }
            }
          }
        },
        "strategies": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "label",
              "description"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "incident_refs": {
                "type": "array",
                "items": {
                  "type": "integer"
                }
              }
            }
          }
