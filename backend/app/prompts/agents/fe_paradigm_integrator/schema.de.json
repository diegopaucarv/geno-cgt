{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "did_state_expand",
    "new_paradigm"
  ],
  "properties": {
    "did_state_expand": {
      "type": "boolean",
      "description": "TRUE wenn mindestens ein neuer Incident das Paradigma erweitert. FALSE wenn alle auf bestehende Elemente abbilden."
    },
    "expansion_type": {
      "type": "string",
      "enum": [
        "NEW_DIMENSION",
        "NEW_CONDITION",
        "NEW_CONSEQUENCE",
        "NEW_STRATEGY",
        "NONE"
      ],
      "description": "Art der Erweiterung. NONE wenn did_state_expand = FALSE."
    },
    "new_paradigm": {
