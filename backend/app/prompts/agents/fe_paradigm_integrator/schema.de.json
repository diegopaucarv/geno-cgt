      "description": "Aktualisiertes Paradigma mit neuen Ergänzungen (falls vorhanden).",
      "properties": {
        "dimensions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "label",
              "description"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "incident_refs": {
                "type": "array",
                "items": {
                  "type": "integer"
                },
                "description": "0-basierte Indizes der Incidente, die diese Dimension stützen."
              }
            }
          }
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "label",
              "description"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "incident_refs": {
                "type": "array",
                "items": {
                  "type": "integer"
                }
              }
            }
          }
        },
        "consequences": {
          "type": "array",
