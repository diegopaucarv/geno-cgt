{
  "type": "object",
  "properties": {
    "reduced_codes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "new_label",
          "entity_type",
          "definition",
          "source_code_ids",
          "relation_to_core"
        ],
        "properties": {
          "new_label": {
            "type": "string",
            "description": "Gerundium des übergeordneten Konzepts (bei Zusammenführung) oder ursprüngliches Label (wenn allein behalten)"
          },
          "entity_type": {
            "type": "string",
            "enum": [
              "core_category",
              "related_category",
              "secondary_code"
            ],
            "description": "Typ im reduzierten System"
          },
          "definition": {
            "type": "string",
            "description": "Integrierte Definition. Bei Zusammenführung muss sie Variationen aller source_codes umfassen"
          },
          "source_code_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "UUIDs der hier zusammengeführten ursprünglichen Codes. Wenn einzelner Code behalten, enthält nur dessen UUID"
          },
          "relation_to_core": {
            "type": "string",
            "enum": [
              "is_the_core",
              "processes",
              "conditions",
              "consequences",
              "strategies"
            ],
            "description": "Art der Beziehung zum Kern-{object_of_study}"
          },
          "properties_inherited": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "gradient": {
                  "type": "string"
                },
                "source_code_id": {
                  "type": "string"
                }
              }
            },
            "description": "Von den Quellcodes geerbte Eigenschaften"
          },
          "interchangeability_rationale": {
            "type": "string",
            "description": "Bei Zusammenführung: warum die source_codes austauschbar sind. Wenn allein behalten: 'N/A — einzelner Code'"
          },
          "needs_more_data": {
            "type": "boolean",
            "description": "true wenn die Zusammenführungsentscheidung mehr empirische Evidenz erfordert"
          }
        }
      }
    },
    "discarded_codes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code_id",
          "code_label",
          "discard_rationale",
          "discard_category"
        ],
        "properties": {
          "code_id": {
            "type": "string"
          },
          "code_label": {
            "type": "string"
          },
          "discard_rationale": {
            "type": "string",
            "description": "Methodologische Rechtfertigung: warum es sich nicht bedeutsam auf das Kern-{object_of_study} bezieht"
          },
          "discard_category": {
            "type": "string",
            "enum": [
              "unrelated_to_core",
              "descriptive_not_behavioral",
              "single_occurrence",
              "superseded_by_fusion"
            ],
            "description": "Verwerfungskategorie"
          }
        }
      }
    },
    "reduction_summary": {
      "type": "object",
      "required": [
        "original_code_count",
        "reduced_code_count",
        "discarded_count",
        "fusion_groups_count"
      ],
      "properties": {
        "original_code_count": {
          "type": "integer"
        },
        "reduced_code_count": {
          "type": "integer"
        },
        "discarded_count": {
          "type": "integer"
        },
        "fusion_groups_count": {
          "type": "integer"
        },
        "reduction_ratio": {
          "type": "number",
          "description": "reduziert / original"
        },
        "methodological_notes": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "reduced_codes",
    "discarded_codes",
    "reduction_summary"
  ]
}
