{
  "type": "object",
  "properties": {
    "reduced_codes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "new_label",
          "entity_type",
          "definition",
          "source_code_ids",
          "relation_to_core"
        ],
        "properties": {
          "new_label": {
            "type": "string",
            "description": "Rótulo do conceito de ordem superior (se fusão) ou rótulo original (se mantido sozinho)"
          },
          "entity_type": {
            "type": "string",
            "enum": [
              "core_category",
              "related_category",
              "secondary_code"
            ],
            "description": "Tipo no sistema reduzido"
          },
          "definition": {
            "type": "string",
            "description": "Definição integrada. Se fusão, deve abranger variações de todos os source_codes"
          },
          "source_code_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "UUIDs de códigos originais fundidos aqui. Se código único mantido, contém apenas seu UUID"
          },
          "relation_to_core": {
            "type": "string",
            "enum": [
              "is_the_core",
              "processes",
              "conditions",
              "consequences",
              "strategies"
            ],
            "description": "Tipo de relação com o {object_of_study} central"
          },
          "properties_inherited": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "gradient": {
                  "type": "string"
                },
                "source_code_id": {
                  "type": "string"
                }
              }
            },
            "description": "Propriedades herdadas dos códigos fonte"
          },
          "interchangeability_rationale": {
            "type": "string",
            "description": "Se fusão: por que os source_codes são intercambiáveis. Se mantido sozinho: 'N/A — código único'"
          },
          "needs_more_data": {
            "type": "boolean",
            "description": "true se a decisão de fusão requer mais evidência empírica"
          }
        }
      }
    },
    "discarded_codes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code_id",
          "code_label",
          "discard_rationale",
          "discard_category"
        ],
        "properties": {
          "code_id": {
            "type": "string"
          },
          "code_label": {
            "type": "string"
          },
          "discard_rationale": {
            "type": "string",
            "description": "Justificativa metodológica: por que não se relaciona significativamente com o {object_of_study} central"
          },
          "discard_category": {
            "type": "string",
            "enum": [
              "unrelated_to_core",
              "descriptive_not_behavioral",
              "single_occurrence",
              "superseded_by_fusion"
            ],
            "description": "Categoria de descarte"
          }
        }
      }
    },
    "reduction_summary": {
      "type": "object",
      "required": [
        "original_code_count",
        "reduced_code_count",
        "discarded_count",
        "fusion_groups_count"
      ],
      "properties": {
        "original_code_count": {
          "type": "integer"
        },
        "reduced_code_count": {
          "type": "integer"
        },
        "discarded_count": {
          "type": "integer"
        },
        "fusion_groups_count": {
          "type": "integer"
        },
        "reduction_ratio": {
          "type": "number",
          "description": "reduzido / original"
        },
        "methodological_notes": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "reduced_codes",
    "discarded_codes",
    "reduction_summary"
  ]
}
