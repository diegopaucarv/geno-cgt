{
  "type": "object",
  "required": [
    "edge_evaluations",
    "system_issues",
    "overall_verdict"
  ],
  "properties": {
    "edge_evaluations": {
      "type": "array",
      "description": "Avaliação para cada aresta proposta.",
      "items": {
        "type": "object",
        "required": [
          "source",
          "target",
          "relationship_type",
          "verdict",
          "rationale",
          "criteria_assessment"
        ],
        "properties": {
          "source": {
            "type": "string",
            "description": "Rótulo do nó origem da aresta sendo avaliada."
          },
          "target": {
            "type": "string",
            "description": "Rótulo do nó destino da aresta sendo avaliada."
          },
          "relationship_type": {
            "type": "string",
            "description": "O relationship_type proposto."
          },
          "verdict": {
            "type": "string",
            "enum": [
              "SAT",
              "MOD",
              "FORCED"
            ],
            "description": "SAT=correto, MOD=precisa de ajuste, FORCED=deve ser removido."
          },
          "rationale": {
            "type": "string",
            "description": "Justificativa narrativa do veredito, referenciando os critérios mais relevantes."
          },
          "criteria_assessment": {
            "type": "object",
            "description": "Avaliação de cada critério.",
            "properties": {
              "relationship_type_correctness": {
                "type": "object",
                "required": [
                  "pass",
                  "note"
                ],
                "properties": {
                  "pass": {
                    "type": "boolean"
                  },
                  "note": {
                    "type": "string"
                  },
                  "suggested_type": {
                    "type": "string",
                    "enum": [
                      "PROCESSES",
                      "LEADS_TO",
                      "IS_A_STRATEGY_FOR",
                      "IS_A_CONSEQUENCE_OF",
                      "IS_A_CONDITION_FOR",
                      "VARIES_WITH",
                      "CO_OCCURS_WITH"
                    ],
                    "description": "Se pass=false: o relationship_type correto."
                  }
                }
              },
              "evidence_sufficiency": {
                "type": "object",
                "required": [
                  "pass",
                  "note"
                ],
                "properties": {
                  "pass": {
                    "type": "boolean"
                  },
                  "note": {
                    "type": "string"
                  }
                }
              },
              "directional_correctness": {
                "type": "object",
                "required": [
                  "pass",
                  "note"
                ],
                "properties": {
                  "pass": {
                    "type": "boolean"
                  },
                  "note": {
                    "type": "string"
                  },
                  "suggested_direction": {
                    "type": "string",
                    "enum": [
                      "unidirectional",
                      "bidirectional",
                      "conceptual",
                      "reversed"
                    ],
                    "description": "Se pass=false: a direção correta."
                  }
                }
              },
              "theoretical_coherence": {
                "type": "object",
                "required": [
                  "pass",
                  "note"
                ],
                "properties": {
                  "pass": {
                    "type": "boolean"
                  },
                  "note": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "suggested_fix": {
            "type": "string",
            "description": "Se MOD: correção concreta (mudar tipo para X, inverter direção, fortalecer evidência com Y). Se FORCED: por que esta aresta deve ser removida."
          }
        }
      }
    },
    "system_issues": {
      "type": "object",
      "required": [
        "contradictions",
        "missing_edges",
        "orphan_nodes",
        "processes_edge_verification"
      ],
      "properties": {
        "contradictions": {
          "type": "object",
          "required": [
            "has_contradictions",
            "details"
          ],
          "properties": {
            "has_contradictions": {
              "type": "boolean"
            },
            "details": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "type",
                  "description",
                  "edges_involved"
                ],
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "circular_causation",
                      "mutual_typing",
                      "type_clash"
                    ],
                    "description": "Tipo de contradição detectada."
                  },
                  "description": {
                    "type": "string"
                  },
                  "edges_involved": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "source": {
                          "type": "string"
                        },
                        "target": {
                          "type": "string"
                        },
                        "relationship_type": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "resolution_suggestion": {
                    "type": "string",
                    "description": "Como resolver a contradição."
                  }
                }
              }
            }
          }
        },
        "missing_edges": {
          "type": "object",
          "required": [
            "has_missing",
            "suggestions"
          ],
          "properties": {
            "has_missing": {
              "type": "boolean"
            },
            "suggestions": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "source",
                  "target",
                  "suggested_type",
                  "rationale",
                  "urgency"
                ],
                "properties": {
                  "source": {
                    "type": "string",
                    "description": "Rótulo do nó origem."
                  },
                  "target": {
                    "type": "string",
                    "description": "Rótulo do nó destino."
                  },
                  "suggested_type": {
                    "type": "string",
                    "enum": [
                      "PROCESSES",
                      "LEADS_TO",
                      "IS_A_STRATEGY_FOR",
                      "IS_A_CONSEQUENCE_OF",
                      "IS_A_CONDITION_FOR",
                      "VARIES_WITH",
                      "CO_OCCURS_WITH"
                    ]
                  },
                  "rationale": {
                    "type": "string",
                    "description": "Por que esta aresta é logicamente necessária."
                  },
                  "urgency": {
                    "type": "string",
                    "enum": [
                      "critical",
                      "important",
                      "nice_to_have"
                    ],
                    "description": "critical=modelo incompleto sem ela, important=melhora significativamente a coerência, nice_to_have=adiciona riqueza."
                  },
                  "evidence_needed": {
                    "type": "string",
                    "description": "Que evidência seria necessária para estabelecer esta aresta."
                  }
                }
              }
            }
          }
        },
        "orphan_nodes": {
          "type": "object",
          "required": [
            "has_orphans",
            "details"
          ],
          "properties": {
            "has_orphans": {
              "type": "boolean"
            },
            "details": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "node_label",
                  "entity_type",
                  "is_legitimate",
                  "rationale"
                ],
                "properties": {
                  "node_label": {
                    "type": "string"
                  },
                  "entity_type": {
                    "type": "string",
                    "enum": [
                      "core_category",
                      "condition",
                      "consequence",
                      "strategy",
                      "dimension"
                    ]
                  },
                  "is_legitimate": {
                    "type": "boolean",
                    "description": "true se este nó sem arestas for teoricamente aceitável (ex., um nó de dimensão)."
                  },
                  "rationale": {
                    "type": "string"
                  },
                  "suggested_connection": {
                    "type": "string",
                    "description": "Se não for legítimo: a qual nó deveria se conectar e como?"
                  }
                }
              }
            }
          }
        },
        "processes_edge_verification": {
          "type": "object",
          "required": [
            "exists",
            "has_correct_source",
            "has_valid_target",
            "is_theoretically_sound"
          ],
          "properties": {
            "exists": {
              "type": "boolean",
              "description": "Existe uma aresta PROCESSES?"
            },
            "has_correct_source": {
              "type": "boolean",
              "description": "A origem é o nó central (is_core=true)?"
            },
            "has_valid_target": {
              "type": "boolean",
              "description": "O destino descreve corretamente o {object_of_study}?"
            },
            "is_theoretically_sound": {
              "type": "boolean",
              "description": "A justificativa explica de forma convincente por que este é o mecanismo central?"
            },
            "issues": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Quaisquer problemas com a aresta PROCESSES."
            }
          }
        }
      }
    },
    "overall_verdict": {
      "type": "object",
      "required": [
        "is_sound",
        "summary"
      ],
      "properties": {
        "is_sound": {
          "type": "boolean",
          "description": "true se o sistema completo de arestas for metodologicamente sólido e estiver pronto para revisão do pesquisador."
        },
        "summary": {
          "type": "string",
          "description": "Avaliação global: o que é sólido? O que precisa de atenção? O modelo integrado é coerente?"
        },
        "blocking_issues": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Problemas que DEVEM ser resolvidos antes que o modelo esteja pronto."
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Preocupações não bloqueantes a anotar para o pesquisador."
        }
      }
    }
  }
}
