        "type": "object",
        "additionalProperties": false,
        "required": [
          "incident_ids",
          "common_pattern"
        ],
        "properties": {
          "incident_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "UUIDs der Incidente in dieser Gruppe"
          },
          "common_pattern": {
            "type": "string",
            "description": "Kurze Beschreibung des gemeinsamen Verhaltensmusters dieser Incidente (1-2 Sätze)"
          }
        }
      }
    },
    "ungrouped": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "UUIDs von Incidenten, die mit keinem anderen austauschbar sind"
    }
  }
