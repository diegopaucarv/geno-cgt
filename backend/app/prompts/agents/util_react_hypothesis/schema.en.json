{
  "type": "object",
  "required": ["hypotheses"],
  "properties": {
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text", "level", "related_codes", "evidence_segments"],
        "properties": {
          "text": {
            "type": "string",
            "description": "Hypothesis in 1-2 sentences."
          },
          "level": {
            "type": "string",
            "enum": ["general", "specific", "emergent"],
            "description": "Level of abstraction."
          },
          "related_codes": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Names of codes it relates."
          },
          "evidence_segments": {
            "type": "array",
            "items": { "type": "string" },
            "description": "IDs of supporting segments."
          },
          "is_well_supported": {
            "type": "boolean",
            "description": "true if the hypothesis has sufficient grounding in the evidence segments provided."
          }
        }
      }
    }
  }
}
