{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "new_categories"
  ],
  "properties": {
    "new_categories": {
      "type": "array",
      "description": "Categorias consolidadas após agrupamento. Array vazio se não forem necessárias alterações.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category",
          "human_purpose",
          "definition"
        ],
        "properties": {
          "category": {
            "type": "string",
            "description": "Rótulo do grupo consolidado."
          },
          "human_purpose": {
            "type": "string",
            "description": "Intenção comportamental subjacente compartilhada pelos códigos agrupados (Passo 1)."
          },
          "definition": {
            "type": "string",
            "description": "Definição consolidada da categoria (Passo 3)."
          },
          "source_codes": {
            "type": "array",
            "description": "Nomes dos códigos originais fundidos nesta categoria.",
            "items": {
              "type": "string"
            }
          },
          "variations": {
            "type": "array",
            "description": "Variações internas documentadas. Array vazio se a categoria for uniforme.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "description"
              ],
              "properties": {
                "description": {
                  "type": "string",
                  "description": "Descrição da variação."
                },
                "documents": {
                  "type": "array",
                  "description": "Nomes dos documentos onde esta variação é observada.",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "theoretical_hypotheses": {
            "type": "array",
            "description": "Hipóteses que emergem deste grupo (Passo 4). Array vazio se não emergirem hipóteses claras.",
            "items": {
              "type": "string"
            }
          },
          "sampling_criteria": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "inclusion",
              "exclusion"
            ],
            "properties": {
              "inclusion": {
                "type": "array",
                "description": "Critérios de inclusão para amostragem futura.",
                "items": {
                  "type": "string"
                }
              },
              "exclusion": {
                "type": "array",
                "description": "Critérios de exclusão.",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "orphan_segments": {
            "type": "array",
            "description": "Segmentos sem código após consolidação (Passo 6). Array vazio se todos estiverem atribuídos.",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
