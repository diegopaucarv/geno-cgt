{
  "type": "object",
  "required": ["evaluations", "ranked_recommendation"],
  "properties": {
    "evaluations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "candidate_statement",
          "verdict",
          "rationale",
          "grounding_assessment"
        ],
        "properties": {
          "candidate_statement": { "type": "string" },
          "verdict": { "type": "string", "enum": ["SAT", "MOD", "FORCED"] },
          "rationale": { "type": "string" },
          "grounding_assessment": { "type": "string" },
          "has_acceptable_coverage": {
            "type": "boolean",
            "description": "true if candidate explains acceptable proportion of system categories."
          },
          "is_confident": {
            "type": "boolean",
            "description": "true if critic is confident in this verdict."
          },
          "abstraction_assessment": {
            "type": "string",
            "enum": ["adequate", "too_concrete", "too_abstract"]
          },
          "suggestion": { "type": "string" }
        }
      }
    },
    "ranked_recommendation": { "type": "string" }
  }
}
