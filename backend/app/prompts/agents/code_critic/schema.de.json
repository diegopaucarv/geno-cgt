{
  "type": "object",
  "required": [
    "all_valid",
    "issues"
  ],
  "properties": {
    "all_valid": {
      "type": "boolean",
      "description": "true wenn alle Codes die Prüfung bestehen."
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code_name",
          "problem",
          "suggestion"
        ],
        "properties": {
          "code_name": {
            "type": "string",
            "description": "Name des problematischen Codes."
          },
          "problem": {
            "type": "string",
            "enum": [
              "vague_definition",
              "overlap",
              "not_grounded",
              "missing_properties"
            ],
            "description": "Art des Problems."
          },
          "suggestion": {
            "type": "string",
            "description": "Wie es zu beheben ist. Ein konkreter Satz."
          }
        }
      }
    }
  }
}
