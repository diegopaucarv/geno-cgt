{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "criteria_assessment",
    "suggestions",
    "rationale"
  ],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "SAT",
        "MOD",
        "FORCED"
      ],
      "description": "Gesamtmethodologisches Urteil für das RQ-OQ-Paar. SAT: beide Fragen erfüllen alle Kriterien. MOD: eine oder beide benötigen spezifische Anpassungen. FORCED: grundlegende Verletzung der CGT-Konventionen."
    },
    "criteria_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cgt_convention",
        "operationalization",
        "population",
        "verb_match",
        "dimensions"
      ],
      "properties": {
        "cgt_convention": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "detail"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "SAT",
                "MOD",
                "FORCED"
              ],
              "description": "Status dieses Kriteriums."
            },
            "detail": {
              "type": "string",
              "description": "Spezifische Bewertung: Folgt die RQ dem kanonischen Format? Passt das Muster zum Typ?"
            }
          }
        },
        "operationalization": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "detail"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "SAT",
                "MOD",
                "FORCED"
              ],
              "description": "Status dieses Kriteriums."
            },
            "detail": {
              "type": "string",
              "description": "Spezifische Bewertung: Ist die OQ singular? Prozessorientiert? Operationalisiert sie die RQ direkt?"
            }
          }
        },
        "population": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "detail"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "SAT",
                "MOD",
                "FORCED"
              ],
              "description": "Status dieses Kriteriums."
            },
            "detail": {
              "type": "string",
              "description": "Spezifische Bewertung: Sind es plurale Akteure? Oder ist es eine Analyseeinheit?"
            }
          }
        },
        "verb_match": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "detail"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "SAT",
                "MOD",
                "FORCED"
              ],
              "description": "Status dieses Kriteriums."
            },
            "detail": {
              "type": "string",
              "description": "Spezifische Bewertung: Passt das Verb zum object_of_study-Typ? Wird es konsistent zwischen RQ und OQ verwendet?"
            }
          }
        },
        "dimensions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "detail"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "SAT",
                "MOD",
                "FORCED"
              ],
              "description": "Status dieses Kriteriums."
            },
            "detail": {
              "type": "string",
              "description": "Spezifische Bewertung: Sind die key_dimensions relevant? Gut begründet? Angemessen in der Anzahl?"
            }
          }
        }
      }
    },
    "suggestions": {
      "type": "array",
      "description": "Konkrete, umsetzbare Verbesserungsvorschläge. Leeres Array wenn Urteil SAT ist. Jeder Vorschlag muss das spezifische Kriterium nennen, das er adressiert.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion",
          "suggestion"
        ],
        "properties": {
          "criterion": {
            "type": "string",
            "enum": [
              "cgt_convention",
              "operationalization",
              "population",
              "verb_match",
              "dimensions"
            ],
            "description": "Welches Kriterium dieser Vorschlag adressiert."
          },
          "suggestion": {
            "type": "string",
            "description": "Konkrete Maßnahme. Z.B.: 'OQ von Plural zu Singular ändern: their concern statt their concerns verwenden', 'Populationseinheit Klassenzimmer durch menschliche Akteure ersetzen: Lehrer und Schüler', 'Das Verb verhandeln passt zum Identitätstyp — beibehalten.'"
          }
        }
      }
    },
    "rationale": {
      "type": "string",
      "description": "Synthese der Bewertung. Erklärt das Gesamturteil durch Zusammenfassung der Stärken und Schwächen über alle fünf Kriterien. Wenn MOD oder FORCED, erklärt welche Kriterien das Urteil bestimmt haben und warum."
    }
  }
}
