{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "criteria_assessment",
    "suggestions",
    "rationale"
  ],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "SAT",
        "MOD",
        "FORCED"
      ],
      "description": "Overall methodological verdict for the RQ-OQ pair. SAT: both questions meet all criteria. MOD: one or both need specific adjustments. FORCED: fundamental violation of CGT conventions."
    },
    "criteria_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cgt_convention",
        "operationalization",
        "population",
        "verb_match",
        "dimensions"
      ],
      "properties": {
        "cgt_convention": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "detail"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "SAT",
                "MOD",
                "FORCED"
              ],
              "description": "Status of this criterion."
            },
            "detail": {
              "type": "string",
              "description": "Specific assessment: does the RQ follow the canonical format? Does the pattern match the type?"
            }
          }
        },
        "operationalization": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "detail"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "SAT",
                "MOD",
                "FORCED"
              ],
              "description": "Status of this criterion."
            },
            "detail": {
              "type": "string",
              "description": "Specific assessment: is the OQ singular? Process-oriented? Does it directly operationalize the RQ?"
            }
          }
        },
        "population": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "detail"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "SAT",
                "MOD",
                "FORCED"
              ],
              "description": "Status of this criterion."
            },
            "detail": {
              "type": "string",
              "description": "Specific assessment: is the population plural actors? Or is it a unit of analysis?"
            }
          }
        },
        "verb_match": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "detail"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "SAT",
                "MOD",
                "FORCED"
              ],
              "description": "Status of this criterion."
            },
            "detail": {
              "type": "string",
              "description": "Specific assessment: does the verb fit the object_of_study type? Is it used consistently between RQ and OQ?"
            }
          }
        },
        "dimensions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "detail"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "SAT",
                "MOD",
                "FORCED"
              ],
              "description": "Status of this criterion."
            },
            "detail": {
              "type": "string",
              "description": "Specific assessment: are the key_dimensions relevant? Well-grounded? Appropriate in number?"
            }
          }
        }
      }
    },
    "suggestions": {
      "type": "array",
      "description": "Concrete, actionable suggestions for improvement. Empty array if verdict is SAT. Each suggestion must reference the specific criterion it addresses.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion",
          "suggestion"
        ],
        "properties": {
          "criterion": {
            "type": "string",
            "enum": [
              "cgt_convention",
              "operationalization",
              "population",
              "verb_match",
              "dimensions"
            ],
            "description": "Which criterion this suggestion addresses."
          },
          "suggestion": {
            "type": "string",
            "description": "Concrete action. E.g.: 'Change OQ from plural to singular: use their concern instead of their concerns', 'Replace population unit classroom with human actors: teachers and students', 'The verb negotiate fits identity type — keep it.'"
          }
        }
      }
    },
    "rationale": {
      "type": "string",
      "description": "Synthesis of the evaluation. Explains the overall verdict by summarizing the strengths and weaknesses across all five criteria. If MOD or FORCED, explains which criteria drove the verdict and why."
    }
  }
}