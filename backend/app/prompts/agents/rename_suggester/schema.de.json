{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name_is_adequate",
    "suggestions"
  ],
  "properties": {
    "name_is_adequate": {
      "type": "boolean",
      "description": "true wenn der aktuelle Name angemessen ist und keine Umbenennung vorgeschlagen wird."
    },
    "adequacy_rationale": {
      "type": "string",
      "description": "Wenn name_is_adequate=true: warum der aktuelle Name immer noch gut ist."
    },
    "suggestions": {
      "type": "array",
      "description": "Umbenennungsvorschläge. Leeres Array wenn name_is_adequate=true.",
      "items": {
        "type": "object",
        "required": [
          "name",
          "level",
          "rationale",
          "what_it_gains"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Vorgeschlagener Name in Gerundium-Form."
          },
          "level": {
            "type": "string",
            "enum": [
              "conservative",
              "moderate",
              "transformative"
            ],
            "description": "Abstraktionsebene der Umbenennung."
          },
          "rationale": {
            "type": "string",
            "description": "Warum dieser Name besser ist."
          },
          "what_it_gains": {
            "type": "string",
            "description": "Welche Dimension oder Eigenschaft es erfasst, die der aktuelle Name auslässt."
          },
          "in_vivo_inspiration": {
            "type": "string",
            "description": "Wenn der Name von den exakten Worten eines Teilnehmers inspiriert ist, diese hier zitieren. Leerer String wenn nicht."
          }
        }
      }
    }
  }
}
