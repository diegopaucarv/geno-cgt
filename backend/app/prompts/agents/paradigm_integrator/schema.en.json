{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "did_state_expand",
    "new_paradigm"
  ],
  "properties": {
    "did_state_expand": {
      "type": "boolean",
      "description": "TRUE if at least one new incident expands the paradigm. FALSE if all map to existing items."
    },
    "expansion_type": {
      "type": "string",
      "enum": [
        "NEW_DIMENSION",
        "NEW_CONDITION",
        "NEW_CONSEQUENCE",
        "NEW_STRATEGY",
        "NONE"
      ],
      "description": "Type of expansion. NONE if did_state_expand = FALSE."
    },
    "new_paradigm": {
      "type": "object",
      "description": "Updated paradigm with new additions (if any).",
      "properties": {
        "dimensions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "label",
              "description"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "incident_refs": {
                "type": "array",
                "items": {
                  "type": "integer"
                },
                "description": "0-based indices of incidents that support this dimension."
              }
            }
          }
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "label",
              "description"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "incident_refs": {
                "type": "array",
                "items": {
                  "type": "integer"
                }
              }
            }
          }
        },
        "consequences": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "label",
              "description"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "incident_refs": {
                "type": "array",
                "items": {
                  "type": "integer"
                }
              }
            }
          }
        },
        "strategies": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "label",
              "description"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "incident_refs": {
                "type": "array",
                "items": {
                  "type": "integer"
                }
              }
            }
          }
        }
      }
    },
    "integration_memo": {
      "type": "string",
      "description": "Methodological note explaining what was added and why, or why it was not expanded."
    }
  }
}