{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "criteria_assessment",
    "suggestions",
    "rationale"
  ],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "SAT",
        "MOD",
        "FORCED"
      ],
      "description": "Veredicto metodológico global para el par RQ-OQ. SAT: ambas preguntas cumplen todos los criterios. MOD: una o ambas necesitan ajustes específicos. FORCED: violación fundamental de las convenciones CGT."
    },
    "criteria_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cgt_convention",
        "operationalization",
        "population",
        "verb_match",
        "dimensions"
      ],
      "properties": {
        "cgt_convention": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "detail"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "SAT",
                "MOD",
                "FORCED"
              ],
              "description": "Estado de este criterio."
            },
            "detail": {
              "type": "string",
              "description": "Evaluación específica: ¿sigue la RQ el formato canónico? ¿El patrón coincide con el tipo?"
            }
          }
        },
        "operationalization": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "detail"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "SAT",
                "MOD",
                "FORCED"
              ],
              "description": "Estado de este criterio."
            },
            "detail": {
              "type": "string",
              "description": "Evaluación específica: ¿es la OQ singular? ¿Orientada al proceso? ¿Operacionaliza directamente la RQ?"
            }
          }
        },
        "population": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "detail"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "SAT",
                "MOD",
                "FORCED"
              ],
              "description": "Estado de este criterio."
            },
            "detail": {
              "type": "string",
              "description": "Evaluación específica: ¿son actores plurales? ¿O es una unidad de análisis?"
            }
          }
        },
        "verb_match": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "detail"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "SAT",
                "MOD",
                "FORCED"
              ],
              "description": "Estado de este criterio."
            },
            "detail": {
              "type": "string",
              "description": "Evaluación específica: ¿el verbo se ajusta al tipo de object_of_study? ¿Se usa consistentemente entre RQ y OQ?"
            }
          }
        },
        "dimensions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "detail"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "SAT",
                "MOD",
                "FORCED"
              ],
              "description": "Estado de este criterio."
            },
            "detail": {
              "type": "string",
              "description": "Evaluación específica: ¿son relevantes las key_dimensions? ¿Bien fundamentadas? ¿Número apropiado?"
            }
          }
        }
      }
    },
    "suggestions": {
      "type": "array",
      "description": "Sugerencias concretas y accionables de mejora. Array vacío si el veredicto es SAT. Cada sugerencia debe referenciar el criterio específico que aborda.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion",
          "suggestion"
        ],
        "properties": {
          "criterion": {
            "type": "string",
            "enum": [
              "cgt_convention",
              "operationalization",
              "population",
              "verb_match",
              "dimensions"
            ],
            "description": "Qué criterio aborda esta sugerencia."
          },
          "suggestion": {
            "type": "string",
            "description": "Acción concreta. Ej.: 'Cambiar OQ de plural a singular: usar su preocupación en lugar de sus preocupaciones', 'Reemplazar unidad poblacional aula por actores humanos: docentes y estudiantes', 'El verbo negociar se ajusta al tipo identidad — mantenerlo.'"
          }
        }
      }
    },
    "rationale": {
      "type": "string",
      "description": "Síntesis de la evaluación. Explica el veredicto global resumiendo las fortalezas y debilidades en los cinco criterios. Si MOD o FORCED, explica qué criterios motivaron el veredicto y por qué."
    }
  }
}
