{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proposed_labels",
    "anomalies"
  ],
  "properties": {
    "proposed_labels": {
      "type": "array",
      "description": "Rótulos propostos para cada grupo.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "group_index",
          "label",
          "definition",
          "properties",
          "supporting_incidents"
        ],
        "properties": {
          "group_index": {
            "type": "integer",
            "description": "Índice do grupo (base 0) no array de entrada"
          },
          "label": {
            "type": "string",
            "description": "Gerúndio nomeando o padrão comportamental"
          },
          "definition": {
            "type": "string",
            "description": "Definição em 1-3 frases. Qual padrão comportamental captura, não qual tópico."
          },
          "properties": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "dimension"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "description": "Nome da propriedade (ex. 'intensidade', 'frequência')"
                },
                "dimension": {
                  "type": "string",
                  "description": "Faixa de variação (ex. 'baixo → alto', 'esporádico → constante')"
                }
              }
            },
            "description": "Propriedades emergentes do padrão com suas dimensões"
          },
          "supporting_incidents": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "UUIDs dos incidentes que respaldam este rótulo (pelo menos 2)"
          },
          "relationship_to_existing": {
            "type": "string",
            "description": "Relação com códigos existentes: 'Novo', 'Subcódigo de X', 'Sobreposição com Y'. Apenas quando existing_labels é fornecido."
          }
        }
      }
    },
    "anomalies": {
      "type": "array",
      "description": "Grupos onde o padrão não está claro ou a rotulagem seria forçada.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "group_index",
          "reason"
        ],
        "properties": {
          "group_index": {
            "type": "integer",
            "description": "Índice do grupo problemático"
          },
          "reason": {
            "type": "string",
            "description": "Por que não pode ser rotulado: padrão ambíguo, incidentes insuficientes, etc."
          }
        }
      }
    }
  }
}
